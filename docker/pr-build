LABEL org.opencontainers.image.authors="Divanshu Chauhan <kazerdira@kazerdira.me>"
LABEL org.opencontainers.image.url="https://kazerdira.me"
LABEL org.opencontainers.image.source="https://github.com/kazerdira/shadow"
LABEL org.opencontainers.image.title="shadow Go Robot - PR Build"
LABEL org.opencontainers.image.description="Pull Request build of shadow Go Robot"
LABEL org.opencontainers.image.vendor="kazerdira"
