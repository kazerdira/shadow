# Required
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
MESSAGE_DUMP=your_private_channel_id

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/shadow?sslmode=disable
AUTO_MIGRATE=true

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1

# Performance (tuned for small VPS)
DISPATCHER_MAX_ROUTINES=50
MAX_CONCURRENT_OPERATIONS=20
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50

# Features
ENABLED_LOCALES=en
DEBUG=false
DROP_PENDING_UPDATES=false
ENABLE_QUERY_PREFETCHING=true
ENABLE_CACHE_PREWARMING=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_RESPONSE_CACHING=true
ENABLE_AUTO_CLEANUP=true
INACTIVITY_THRESHOLD_DAYS=30

# Webhooks — off for now
USE_WEBHOOKS=false